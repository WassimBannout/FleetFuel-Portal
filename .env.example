# FleetFuel Portal: local Docker development settings.
# `make setup` copies this file to .env only when .env is absent and fills the
# empty database passwords with random local values. Never commit .env.

APP_NAME="FleetFuel Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Host port for the nginx `web` container (published on 127.0.0.1 only).
APP_PORT=8080

# Docker Compose project name: containers, volumes and the PHP image are named
# after it. Unset means "fleetfuel". A second copy of the repository on the
# same machine needs its own name and APP_PORT (README, "A second copy").
# COMPOSE_PROJECT_NAME=fleetfuel-copy

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Timestamps are stored in UTC (config/app.php). Quota months and display use
# this zone. The 72-hour FX/POS age limits live in config/fleetfuel.php.
BUSINESS_TIMEZONE=Asia/Beirut

# MySQL runs in the `mysql` service; inside containers never use localhost.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fleetfuel
DB_USERNAME=fleetfuel
DB_PASSWORD=

# The separate test database is created on the first MySQL start.
# `make setup` copies this password into .env.testing.
DB_TEST_DATABASE=fleetfuel_test
DB_TEST_USERNAME=fleetfuel_test
DB_TEST_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No queue worker runs in the MVP (docs/09-OPERATIONS-AND-PORTFOLIO.md).
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Emails go to the log. To inspect them in Mailpit instead, run
# `docker compose --profile mail up -d mailpit`, set MAIL_MAILER=smtp and open
# http://localhost:8025.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@fleetfuel.test"
MAIL_FROM_NAME="${APP_NAME}"

# `fixture` uses synthetic demo rates and never calls the provider; `live`
# lets `php artisan rates:sync` call the fixed endpoint in
# config/fleetfuel.php (never user input). Live mode ignores fixture rates.
EXCHANGE_RATE_MODE=fixture

# Fictional demo data, seeded into an empty local database by `make setup`.
# `make setup` fills DEMO_PASSWORD with a random local value when it creates
# .env; all demo accounts share it and it is stored hashed. See README.
DEMO_MODE=true
DEMO_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# FleetFuel Portal: automated test settings.
# `make setup` copies this file to .env.testing when absent and fills
# DB_PASSWORD from DB_TEST_PASSWORD in .env. phpunit.xml also forces the test
# database name, and tests refuse to run against any other database.

APP_NAME="FleetFuel Portal"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=single
LOG_LEVEL=debug

BUSINESS_TIMEZONE=Asia/Beirut

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fleetfuel_test
DB_USERNAME=fleetfuel_test
DB_PASSWORD=

EXCHANGE_RATE_MODE=fixture

DEMO_MODE=false
DEMO_PASSWORD=

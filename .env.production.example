# Production settings for the FleetFuel Portal image (docs/RUNBOOK.md).
# Copy to .env.production on the deployment machine, or enter the same
# variables in your host's secret manager. Never commit the filled-in file.

APP_NAME="FleetFuel Portal"
APP_ENV=production
APP_DEBUG=false
# Generate once and keep it with the deployment secrets (not in backups):
#   docker run --rm --entrypoint php fleetfuel-portal:local artisan key:generate --show
APP_KEY=
APP_URL=https://fleetfuel.example.com
# Host port of the app container in compose.production.yaml (bound to 127.0.0.1).
APP_PORT=8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# The container logs to its output; the host collects and keeps the logs.
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

BUSINESS_TIMEZONE=Asia/Beirut

# A durable MySQL 8.4 database. With compose.production.yaml the `mysql`
# service creates this database and user on its first start.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fleetfuel
DB_USERNAME=fleetfuel
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Session cookies only over HTTPS. Only a plain-HTTP rehearsal on your own
# machine may set false.
SESSION_SECURE_COOKIE=true

# The HTTPS proxy or load balancer in front of the container: its addresses
# (comma-separated IPs or CIDR ranges), whose X-Forwarded-* headers tell the
# app the original scheme, host and client address. Empty trusts nobody.
TRUSTED_PROXIES=

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@fleetfuel.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# `fixture` labels synthetic rates; `live` calls ExchangeRate-API's open
# endpoint daily (attribution is shown on the screens).
EXCHANGE_RATE_MODE=fixture

# A dedicated public-demo deployment only: DEMO_MODE=true lets an operator run
# `php artisan demo:seed --force` once, on an empty database. Every demo
# account shares DEMO_PASSWORD. Keep both off for real data.
DEMO_MODE=false
DEMO_PASSWORD=

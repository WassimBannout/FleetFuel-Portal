    {
      "name": "02 — Manager access (M06)",
      "item": [
        {
          "name": "Issue manager token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/auth/token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{manager_email}}\",\n  \"password\": \"{{demo_password}}\",\n  \"device_name\": \"postman-local\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const payload = pm.response.json();",
                  "pm.test(\"Token is present\", () => pm.expect(payload.data.token).to.be.a(\"string\").and.not.empty);",
                  "pm.environment.set(\"manager_token\", payload.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Own vehicles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{manager_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/vehicles"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const ids = pm.response.json().data.map((vehicle) => vehicle.company_id);",
                  "pm.test(\"One company only\", () => pm.expect(new Set(ids).size).to.be.at.most(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Own drivers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{manager_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/drivers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const ids = pm.response.json().data.map((driver) => driver.company_id);",
                  "pm.test(\"One company only\", () => pm.expect(new Set(ids).size).to.be.at.most(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Own ledger",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{manager_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/transactions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Filtered totals exist\", () => pm.expect(pm.response.json().meta.totals).to.have.keys(\"liters\", \"amount_lbp\", \"amount_usd\"));"
                ]
              }
            }
          ]

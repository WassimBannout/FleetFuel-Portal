{
  "info": {
    "name": "FleetFuel Portal — target MVP contract",
    "description": "Prepared before implementation. Run against fresh local demo fixtures after M08 for the whole collection, or run completed folders after M06. Password/tokens belong in an untracked local environment. POS requests generate a current timestamp once, then reuse it for replay. See postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 — POS scenario (M06)",
      "item": [
        {
          "name": "Issue station token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/auth/token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{station_email}}\",\n  \"password\": \"{{demo_password}}\",\n  \"device_name\": \"postman-local\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const payload = pm.response.json();",
                  "pm.test(\"Token is present\", () => pm.expect(payload.data.token).to.be.a(\"string\").and.not.empty);",
                  "pm.environment.set(\"station_token\", payload.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Active stations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{station_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/stations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Current prices",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{station_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/products/prices"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Initial card balance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{station_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/cards/{{card_no}}/balance"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Accept one purchase",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{station_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_ref\": \"{{external_ref}}\",\n  \"card_no\": \"{{card_no}}\",\n  \"product_code\": \"DIESEL\",\n  \"liters\": \"20.00\",\n  \"transacted_at\": \"{{event_time}}\",\n  \"odometer_km\": 45000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"external_ref\", \"PM-\" + Date.now() + \"-\" + Math.floor(Math.random() * 100000));",
                  "pm.environment.set(\"event_time\", new Date(Date.now() - 1000).toISOString().replace(/\\.\\d{3}Z$/, \"Z\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json().data;",
                  "pm.environment.set(\"transaction_id\", data.id);",
                  "pm.environment.set(\"original_transaction\", JSON.stringify(data));",
                  "pm.test(\"Volume is a decimal string\", () => pm.expect(data.liters).to.eql(\"20.00\"));",
                  "pm.test(\"Money is a string\", () => pm.expect(data.amount_usd).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay identical purchase",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{station_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_ref\": \"{{external_ref}}\",\n  \"card_no\": \"{{card_no}}\",\n  \"product_code\": \"DIESEL\",\n  \"liters\": \"20.00\",\n  \"transacted_at\": \"{{event_time}}\",\n  \"odometer_km\": 45000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Replay header\", () => pm.expect(pm.response.headers.get(\"Idempotency-Replayed\")).to.eql(\"true\"));",
                  "pm.test(\"Original data returned\", () => pm.expect(pm.response.json().data).to.deep.eql(JSON.parse(pm.environment.get(\"original_transaction\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Conflicting retry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"

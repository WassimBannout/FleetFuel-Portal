{
  "info": {
    "name": "FleetFuel Portal — API scenarios",
    "description": "Scenario collection for the FleetFuel Portal API (fictional data). Folders 01, 02 and 05 run against the implemented API (M06); folder 03 needs M07 (deliveries) and folder 04 needs M08 (reports and CSV). Password and tokens belong only in your selected, untracked environment. The first purchase saves its generated payload; replay and conflict reuse it. See postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 — POS scenario (M06)",
      "item": [
        {
          "name": "Issue station token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{base_url}}/auth/token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{station_email}}\",\n  \"password\": \"{{demo_password}}\",\n  \"device_name\": \"postman-local\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const payload = pm.response.json();",
                  "pm.test(\"Token is present\", () => pm.expect(payload.data.token).to.be.a(\"string\").and.not.empty);",
                  "pm.environment.set(\"station_token\", payload.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Active stations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{station_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/stations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"Only active stations\", () => pm.expect(body.data.every((s) => s.is_active === true)).to.be.true);",
                  "pm.test(\"Page metadata\", () => pm.expect(body.meta).to.have.keys(\"current_page\", \"per_page\", \"last_page\", \"total\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Current prices",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{station_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/products/prices"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const diesel = pm.response.json().data.find((row) => row.product_code === \"DIESEL\");",
                  "pm.test(\"DIESEL has an LBP price as a 4-decimal string\", () => pm.expect(diesel.unit_price_lbp).to.match(/^\\d+\\.\\d{4}$/));",
                  "pm.test(\"Indicative USD price and rate provenance\", () => { pm.expect(diesel.indicative_unit_price_usd).to.match(/^\\d+\\.\\d{4}$/); pm.expect([\"fixture\", \"provider\", \"manual\"]).to.include(diesel.rate_source); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Initial card balance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{station_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/cards/{{card_no}}/balance"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const cents = (s) => { const [whole, fraction = \"\"] = String(s).split(\".\"); return parseInt(whole, 10) * 100 + parseInt((fraction + \"00\").slice(0, 2), 10); };",
                  "const balance = pm.response.json().data;",
                  "pm.test(\"Card is active\", () => pm.expect(balance.status).to.eql(\"active\"));",
                  "pm.test(\"At least 20.00 L left (otherwise prepare fresh cards, see README)\", () => pm.expect(balance.remaining_l === null || cents(balance.remaining_l) >= 2000).to.be.true);",
                  "pm.environment.set(\"initial_used_l\", balance.used_l);",
                  "pm.environment.set(\"initial_remaining_l\", balance.remaining_l === null ? \"\" : balance.remaining_l);"
                ]
              }
            }
          ]
        },
        {
          "name": "Accept one purchase",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{station_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/transactions",
            "body": {
              "mode": "raw",
              "raw": "{{purchase_payload}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new reference and the current time, saved once; replay and conflict reuse this exact payload.",
                  "pm.environment.set(\"external_ref\", \"PM-\" + Date.now() + \"-\" + Math.floor(Math.random() * 100000));",
                  "pm.environment.set(\"event_time\", new Date(Date.now() - 2000).toISOString().replace(/\\.\\d{3}Z$/, \"Z\"));",
                  "pm.environment.set(\"purchase_payload\", JSON.stringify({",
                  "  external_ref: pm.environment.get(\"external_ref\"),",
                  "  card_no: pm.environment.get(\"card_no\"),",
                  "  product_code: \"DIESEL\",",
                  "  liters: \"20.00\",",
                  "  transacted_at: pm.environment.get(\"event_time\"),",
                  "  odometer_km: 45000",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const purchase = pm.response.json().data;",
                  "pm.environment.set(\"transaction_id\", purchase.id);",
                  "pm.environment.set(\"original_transaction\", JSON.stringify(purchase));",
                  "pm.test(\"Location header names the purchase\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/v1/transactions/\" + purchase.id));",
                  "pm.test(\"Volume is a decimal string\", () => pm.expect(purchase.liters).to.eql(\"20.00\"));",
                  "pm.test(\"Money is a string\", () => pm.expect(purchase.amount_usd).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay identical purchase",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{station_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/transactions",
            "body": {
              "mode": "raw",
              "raw": "{{purchase_payload}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Replay header\", () => pm.expect(pm.response.headers.get(\"Idempotency-Replayed\")).to.eql(\"true\"));",
                  "pm.test(\"Original data returned\", () => pm.expect(pm.response.json().data).to.deep.eql(JSON.parse(pm.environment.get(\"original_transaction\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Conflicting retry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{station_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/transactions",
            "body": {
              "mode": "raw",
              "raw": "{{conflict_payload}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The saved payload with only the liters changed.",
                  "const payload = JSON.parse(pm.environment.get(\"purchase_payload\"));",
                  "payload.liters = \"21.00\";",
                  "pm.variables.set(\"conflict_payload\", JSON.stringify(payload));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });",
                  "pm.test(\"Conflict code\", () => pm.expect(pm.response.json().error.code).to.eql(\"idempotency_conflict\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Blocked card decline",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",

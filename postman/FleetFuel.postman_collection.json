            "url": "{{base_url}}/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_ref\": \"{{external_ref}}\",\n  \"card_no\": \"{{card_no}}\",\n  \"product_code\": \"DIESEL\",\n  \"liters\": \"21.00\",\n  \"transacted_at\": \"{{event_time}}\",\n  \"odometer_km\": 45000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }

              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Exactly one 20-liter debit on fresh fixture\", () => pm.expect(pm.response.json().data.used_l).to.eql(\"20.00\"));",
                  "pm.test(\"Remaining liters\", () => pm.expect(pm.response.json().data.remaining_l).to.eql(\"80.00\"));"
                ]
              }
            }
          ]
        },
        {

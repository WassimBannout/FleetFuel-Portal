    {
      "name": "03 — Delivery scenario (M07)",
      "item": [
        {
          "name": "Create pending order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{manager_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/delivery-orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"Fictional Warehouse, Beirut\",\n  \"governorate\": \"Beirut\",\n  \"liters\": \"500.00\",\n  \"preferred_start_at\": \"{{preferred_start}}\",\n  \"preferred_end_at\": \"{{preferred_end}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"preferred_start\", new Date(Date.now() + 86400000).toISOString().replace(/\\.\\d{3}Z$/, \"Z\"));",
                  "pm.environment.set(\"preferred_end\", new Date(Date.now() + 90000000).toISOString().replace(/\\.\\d{3}Z$/, \"Z\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.environment.set(\"delivery_id\", pm.response.json().data.id);",
                  "pm.test(\"Pending\", () => pm.expect(pm.response.json().data.status).to.eql(\"pending\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read order history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{manager_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/delivery-orders/{{delivery_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Manager cancels pending order",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{manager_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/delivery-orders/{{delivery_id}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expected_status\": \"pending\",\n  \"status\": \"cancelled\",\n  \"reason\": \"Postman local fixture cancellation\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [

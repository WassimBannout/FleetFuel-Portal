            },
            "url": "{{base_url}}/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_ref\": \"{{external_ref}}-BLOCKED\",\n  \"card_no\": \"{{blocked_card_no}}\",\n  \"product_code\": \"DIESEL\",\n  \"liters\": \"20.00\",\n  \"transacted_at\": \"{{event_time}}\",\n  \"odometer_km\": 45000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"Blocked code\", () => pm.expect(pm.response.json().error.code).to.eql(\"card_blocked\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Over-quota decline",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{station_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_ref\": \"{{external_ref}}-QUOTA\",\n  \"card_no\": \"{{tiny_card_no}}\",\n  \"product_code\": \"DIESEL\",\n  \"liters\": \"6.00\",\n  \"transacted_at\": \"{{event_time}}\",\n  \"odometer_km\": 45000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"Quota code\", () => pm.expect(pm.response.json().error.code).to.eql(\"quota_exceeded\"));",
                  "pm.test(\"Liter limit\", () => pm.expect(pm.response.json().error.details.dimension).to.eql(\"liters\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Purchase detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{station_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/transactions/{{transaction_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Same transaction\", () => pm.expect(String(pm.response.json().data.id)).to.eql(String(pm.environment.get(\"transaction_id\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Balance after one accepted purchase",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{station_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/cards/{{card_no}}/balance"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const cents = (s) => { const [whole, fraction = \"\"] = String(s).split(\".\"); return parseInt(whole, 10) * 100 + parseInt((fraction + \"00\").slice(0, 2), 10); };",
                  "const balance = pm.response.json().data;",
                  "pm.test(\"Exactly one 20.00 L debit (replay and declines charged nothing)\", () => pm.expect(cents(balance.used_l) - cents(pm.environment.get(\"initial_used_l\"))).to.eql(2000));",
                  "pm.test(\"Remaining liters went down by 20.00\", () => { const before = pm.environment.get(\"initial_remaining_l\"); if (before !== \"\") { pm.expect(cents(before) - cents(balance.remaining_l)).to.eql(2000); } });"
                ]
              }
            }
          ]
        },
        {
          "name": "Station field refused",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{station_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_ref\": \"{{external_ref}}-STATION\",\n  \"card_no\": \"{{card_no}}\",\n  \"product_code\": \"DIESEL\",\n  \"liters\": \"20.00\",\n  \"transacted_at\": \"{{event_time}}\",\n  \"station_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/transactions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 422\", function () { pm.response.to.have.status(422); });",
                  "pm.test(\"station_id is not accepted\", () => pm.expect(pm.response.json().error.details).to.have.property(\"station_id\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Station cannot list vehicles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{station_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/vehicles"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Station cannot change a card",
          "request": {
            "method": "PATCH",
            "header": [
